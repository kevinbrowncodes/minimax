{
  "name": "minimax-local",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter app --filter stub-generation-server test",
    "build": "pnpm --filter app build",
    "start": "pnpm --filter app start",
    "recon:login": "pnpm --filter recon login",
    "recon:check": "pnpm --filter recon check",
    "recon:capture": "pnpm --filter recon capture",
    "recon:tokens": "pnpm --filter recon tokens",
    "recon:interactions": "pnpm --filter recon interactions",
    "test:integration": "pnpm --filter app test:integration"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
