# Copy to .env (gitignored). Read by compose.yaml and by the app (app/lib/config.ts).
# The generation server the UI talks to: the Spark's adapter (STORY_006) on the shared docker network; the gate uses the stub.
MODEL_BASE_URL=http://adapter:4020
# Optional bearer token sent to the generation server.
MODEL_API_KEY=
# Host port the UI is published on (the owner opens http://<spark-lan-address>:APP_PORT from a browser).
APP_PORT=3000
# Optional: the adapter's own bearer token (spark/comfyui/compose.yaml); set MODEL_API_KEY to the same value.
ADAPTER_API_KEY=
# Host port the adapter is published on, on 127.0.0.1 only (for curl).
ADAPTER_PORT=4020
# Agent mode (STORY_047, EPIC_009): Vertex AI on the owner's own GCP project. spark/gcloud/setup-vertex.sh writes the first
# two; Settings › Environment variables can override all three. The service-account key is mounted read-only by compose
# from spark/data/secrets/vertex-sa.json (gitignored) — never put it here. The photos and notes given to the agent go to Google.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# The Gemini model id, pinned by STORY_048's spike from Vertex's model list; unset until then (the Agent chip says so).
VERTEX_MODEL=
