# Copy to .env (gitignored). Read by compose.yaml and by the app (app/lib/config.ts).
# The generation server the UI talks to: the Spark's adapter (STORY_006) on the shared docker network; the gate uses the stub.
MODEL_BASE_URL=http://adapter:4020
# Optional bearer token sent to the generation server.
MODEL_API_KEY=
# Host port the UI is published on (the owner opens http://<spark-lan-address>:APP_PORT from a browser).
APP_PORT=3000
# Optional: the adapter's own bearer token (spark/comfyui/compose.yaml); set MODEL_API_KEY to the same value.
ADAPTER_API_KEY=
# Host port the adapter is published on, on 127.0.0.1 only (for curl).
ADAPTER_PORT=4020
